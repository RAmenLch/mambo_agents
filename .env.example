# ============================================================
# Mambo Agents - 环境变量模板
# ------------------------------------------------------------
# 使用方法：
#   1. 复制本文件为 .env      ->  cp .env.example .env
#   2. 填入你自己的密钥
#   3. 运行示例，例如：
#        python example/01_quick_start.py
#      示例通过 load_dotenv() 从项目根自动加载 .env。
# ============================================================

# [必需] DeepSeek API Key，用于运行集成级复现 / 需要真实 LLM 的示例。
# 未配置时，纯中间件机制级复现（无需 API Key）仍可正常运行。
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [可选] DeepSeek API Base URL，默认即为下方地址，一般无需修改。
DEEPSEEK_API_BASE=https://api.deepseek.com
